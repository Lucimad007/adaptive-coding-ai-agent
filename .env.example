# OpenCode Go (Zen Go) API key from https://opencode.ai/auth
OPENCODE_API_KEY=sk-your-key-here

# Optional overrides
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-flash
# Image paste is off unless this (or OPENCODE_MODEL) is a vision model:
# OPENCODE_VISION_MODEL=deepseek-v4-flash-vision-exp
WORKSPACE_ROOT=
