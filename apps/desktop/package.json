{
  "name": "@harness/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test workspace.spec.mjs worker-protocol.spec.mjs",
    "dist": "electron-builder --win nsis dir"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1"
  },
  "devDependencies": {
    "electron": "29.4.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.patchline.app",
    "productName": "Patchline",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "main.mjs",
      "preload.cjs",
      "terminal.mjs",
      "workspace.mjs",
      "python.mjs",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**",
      "node_modules/node-pty/**"
    ]
  }
}
