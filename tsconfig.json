{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": "apps/web",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "apps/web/vite.config.ts"]
}
